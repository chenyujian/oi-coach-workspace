# Compiled C++ binaries & debug artifacts (Windows / macOS)
*.exe
*.out
*.o
*.obj
*.pdb
*.dSYM/
a.out
tempCodeRunnerFile.*

# IDE & Editor caches
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Local secrets & runtime caches
.env
.env.local
*.secret
__pycache__/
*.pyc
.dsh/cache/
.dsh/logs/

# Large raw course slides/PDFs (only refined Markdown notes in courses/notes/ are synced)
courses/raw/*.pdf
courses/raw/*.pptx
courses/raw/*.ppt
courses/raw/*.zip
